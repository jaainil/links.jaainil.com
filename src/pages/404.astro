---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404: Page Not Found — Jainil Prajapati"
  description="The piece or page you're looking for doesn't exist or has been moved."
  canonical={null}
  noindex={true}
  nofollow={true}
>
  <main class="flex min-h-screen items-center justify-center bg-background px-4 text-foreground">
    <div class="max-w-md text-center">
      <span class="status-chip mb-4 inline-block">PIECE NOT FOUND</span>
      <h1 class="text-7xl font-black tracking-tight text-foreground">404</h1>
      <h2 class="mt-4 text-xl font-bold text-foreground">Page not found</h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">
        The piece or page you're looking for doesn't exist or has been moved.
      </p>
      <div class="mt-6">
        <a
          href="/"
          class="email-button inline-flex"
        >
          Return to build kit
        </a>
      </div>
    </div>
  </main>
</Layout>
